rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    // Any request that carries a valid Firebase Auth ID token.
    function isSignedIn() {
      return request.auth != null;
    }

    // Only Google accounts with an entry in /allowlist may use the app.
    // Membership is data, not code — see the /allowlist match block below
    // for how entries are added/removed.
    function isNuUser() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@nu\\.ac\\.th$')
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // The email a doc claims as its author must match the caller's own
    // verified email, so nobody can write data and attribute it to someone
    // else.
    function claimsOwnEmail(data) {
      return data.createdBy == request.auth.token.email;
    }

    // ---------------------------------------------------------------------
    // /activities/{activityId}
    //   Top-level shared task boards. The allowed user can see/collaborate
    //   on every activity
    //   (this matches how the app itself queries and renders data — there
    //   is no per-user filtering in the client).
    // ---------------------------------------------------------------------
    match /activities/{activityId} {
      allow read: if isNuUser();

      // Creating an activity: must be signed in as the allowed account, must claim
      // yourself as the creator, and must start from a clean taskStats
      // counter (can't fabricate progress on creation).
      allow create: if isNuUser()
        && claimsOwnEmail(request.resource.data)
        && request.resource.data.taskStats.total == 0
        && request.resource.data.taskStats.done == 0;

      // Updating an activity: in practice this is only ever the
      // taskStats.{total,done} counters, bumped whenever any team member
      // creates/edits/deletes a task in one of its departments. Restrict
      // the update to touching only those two fields — the name,
      // createdBy, and createdAt of an activity can't be changed this way.
      allow update: if isNuUser()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['taskStats']);

      // The allowed account can delete an activity.
      allow delete: if isNuUser();

      // ---------------------------------------------------------------------
      // /activities/{activityId}/departments/{departmentId}
      //   Fixed set of columns seeded when an activity is created. The app
      //   never edits these, but deleting an activity cascades down and
      //   removes its department docs too (Firestore doesn't do this on
      //   its own), so delete has to be allowed here as well.
      // ---------------------------------------------------------------------
      match /departments/{departmentId} {
        allow read: if isNuUser();
        allow create: if isNuUser();
        allow delete: if isNuUser();
        // No update flow exists in the app today; default-deny.

        // ---------------------------------------------------------------------
        // /activities/{activityId}/departments/{departmentId}/tasks/{taskId}
        //   The actual to-do cards. The allowed account can create,
        //   edit, or delete a task, mirroring the shared-board UI.
        // ---------------------------------------------------------------------
        match /tasks/{taskId} {
          allow read: if isNuUser();

          allow create: if isNuUser() && claimsOwnEmail(request.resource.data);

          // Edits (status changes, details, image, etc.) are allowed by any
          // team member, but the task's recorded author can't be rewritten
          // after the fact.
          allow update: if isNuUser()
            && request.resource.data.createdBy == resource.data.createdBy;

          allow delete: if isNuUser();
        }
      }
    }

    // ---------------------------------------------------------------------
    // /allowlist/{email}
    //   The actual access-control list. One doc per allowed account, keyed
    //   by lowercased email — the doc's content doesn't matter, only its
    //   existence. To grant access, add a document here (e.g. from the
    //   Firebase console's Firestore tab) with that email, lowercased, as
    //   the document ID; to revoke, delete it. No rules redeploy needed
    //   either way.
    //   A signed-in user may only read their own entry (to check "am I
    //   allowed"), never list the whole collection or anyone else's entry.
    //   Nothing in the app ever writes here — entries are managed by hand
    //   (or the Admin SDK/console, which bypasses these rules).
    // ---------------------------------------------------------------------
    match /allowlist/{email} {
      allow get: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // ---------------------------------------------------------------------
    // /users/{uid}
    //   Not currently used by the app (createdBy stores an email string,
    //   not a profile doc), but reserved here in case a user-profile
    //   feature is added later. A user may only read/write their own
    //   profile document, and only while authenticated as the allowed
    //   account, with a uid matching the document id.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isNuUser() && request.auth.uid == uid;
      allow create, update: if isNuUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Deny everything else by default (defense in depth — every real path
    // above is already explicit, this just makes sure nothing new can slip
    // through unauthenticated or from any other account).
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
